{
  "name": "kit-production-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "dev": "tsx server.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "test": "vitest run src server",
    "test:browser": "playwright test",
    "format": "prettier --write src tests *.ts *.json index.html README.md",
    "typecheck": "tsc -b",
    "lint": "tsc -b",
    "dev:server": "tsx watch --env-file-if-exists=.env server/index.ts",
    "start": "tsx server.ts",
    "backup": "tsx --env-file-if-exists=.env server/scheduled-backup.ts",
    "perf": "tsx server/perf/workspace-perf.ts",
    "test:server": "vitest run server"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@google/genai": "^2.32.0",
    "@tauri-apps/api": "^2.12.4",
    "express": "^5.3.0",
    "firebase": "^13.1.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "three": "^0.180.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.12.3",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "vitest": "^5.0.5"
  }
}
