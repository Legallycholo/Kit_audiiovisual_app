{
  "name": "kit-production-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "dev": "tsx --env-file-if-exists=.env server.ts",
    "build": "tsc -b && vite build",
    "build:api": "tsx scripts/build-api.ts",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "test": "vitest run src server --testTimeout=15000",
    "test:browser": "playwright test",
    "format": "prettier --write src tests *.ts *.json index.html README.md",
    "typecheck": "tsc -b",
    "lint": "tsc -b",
    "dev:server": "tsx watch --env-file-if-exists=.env server/index.ts",
    "start": "tsx server.ts",
    "backup": "tsx --env-file-if-exists=.env server/scheduled-backup.ts",
    "migrate:sqlite": "tsx --env-file-if-exists=.env scripts/sqlite-to-postgres.ts",
    "perf": "tsx server/perf/workspace-perf.ts",
    "test:server": "vitest run server --testTimeout=15000"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.5.0",
    "@supabase/supabase-js": "^2.119.0",
    "@tauri-apps/api": "^2.12.4",
    "@vercel/functions": "^3.11.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express": "^5.3.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite-socket": "^0.2.18",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.3",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "vitest": "^5.0.5"
  }
}
