# Supabase sign-in (project: kit audio visual).
# Copy these into .env. The two VITE_ values are published by design and safe
# in the client bundle; everything below them is server-only.
VITE_SUPABASE_URL=https://shskkpnzevrzbnccdzyc.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_0XoAZXKZpG-3pAn8FQMiDQ_BI9ZsgbW
# Server-only (never prefix with VITE_). Both are required before
# POST /api/login/supabase will accept a sign-in.
SUPABASE_URL=https://shskkpnzevrzbnccdzyc.supabase.co
# Dashboard › Project Settings › API › service_role. Secret: it bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=
# Only for projects still signing tokens with the legacy shared secret
# (Dashboard › Project Settings › API › JWT Secret). Asymmetric projects are
# verified against the published JWKS and need nothing here.
SUPABASE_JWT_SECRET=
# Direct Postgres connection, for migrations run from a terminal.
SUPABASE_DB_URL=
