# Server-only settings. Copy to .env for local work; never commit it and never put a secret in a VITE_ variable.
# Blank values leave the feature off (local runs and tests need none of them).

# Database: unset = local PGlite in .kit-local/pglite; postgres:// = the hosted Supabase project (role kit_server).
KIT_DATABASE=
KIT_DATABASE_POOL_MAX=
KIT_DATABASE_CA=

# Sessions, origins, logging
KIT_ORIGINS=
KIT_SECURE_COOKIES=
KIT_LOG_LEVEL=
CRON_SECRET=
KIT_JOB_STALE_MS=

# Optional local seed: start a fresh local database from the sample workspace with this owner.
KIT_SEED_OWNER_PASSWORD=
KIT_SEED_OWNER_EMAIL=
KIT_SEED_OWNER_NAME=

# Supabase (portal sign-in; the publishable key is public, the secret key is server-only and powers KIT Design storage)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# AI provider for proposal drafting, KIT chat and KIT Design specs (anthropic | openai | gemini)
KIT_AI_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
KIT_AI_MODEL=
KIT_CHAT_MODEL=
KIT_PLAN_MODEL=

# KIT Design renders and videos (Higgsfield), with monthly caps
HIGGSFIELD_API_KEY=
HIGGSFIELD_KEY_ID=
HIGGSFIELD_KEY_SECRET=
KIT_DESIGN_RENDER_MODEL=
KIT_DESIGN_VIDEO_MODEL=
KIT_DESIGN_VIDEO_SECONDS=
KIT_DESIGN_MONTHLY_RENDER_CAP=
KIT_DESIGN_MONTHLY_VIDEO_CAP=

# Web lookup (SerpApi) in the equipment, venue and event forms
SERPAPI_API_KEY=
KIT_SERPAPI_MONTHLY_CAP=

# Messaging and email (status only until a transport is connected)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
KIT_EMAIL_PROVIDER=
KIT_EMAIL_API_KEY=
KIT_EMAIL_FROM=

# Personal cloud search index
KIT_SEARCH_PROVIDER_NAME=
KIT_SEARCH_PROVIDER_URL=
KIT_SEARCH_PROVIDER_TOKEN=
KIT_SEARCH_REGION=
KIT_SEARCH_RETENTION=
KIT_SEARCH_ENCRYPTION_KEY=
KIT_SEARCH_MONTHLY_BUDGET_CENTS=
KIT_SEARCH_CENTS_PER_1000_CHARS=

# Backups (npm run backup)
KIT_BACKUP_DIR=
KIT_BACKUP_KEEP=

# reCAPTCHA Enterprise for the local password login (unused with the portal)
RECAPTCHA_PROJECT_ID=
RECAPTCHA_API_KEY=
RECAPTCHA_SITE_KEY=
VITE_RECAPTCHA_SITE_KEY=
