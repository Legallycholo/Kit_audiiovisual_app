# Server-only configuration. Never use VITE_ for credentials or private settings.
PORT=3001
KIT_DATABASE=data/kit.sqlite
KIT_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:3001
# Set true behind an HTTPS reverse proxy in production.
KIT_SECURE_COOKIES=false
# JSON log lines: debug, info (one line per API request), warn, error or silent.
KIT_LOG_LEVEL=info
# `npm run backup` writes checksummed backups here and keeps the newest N.
KIT_BACKUP_DIR=data/backups
KIT_BACKUP_KEEP=14

# Optional AI proposal drafting and shared KIT chat. Keep values server-only.
# Use an account-authorized model supporting Responses Structured Outputs.
OPENAI_API_KEY=
KIT_AI_MODEL=
KIT_CHAT_MODEL=

# Optional server-side semantic search adapter. Disabled until all are approved.
# HTTPS service implementing docs/DESKTOP_PHASES_3_4.md, not a vendor's raw API URL.
KIT_SEARCH_PROVIDER_URL=
KIT_SEARCH_PROVIDER_TOKEN=
KIT_SEARCH_PROVIDER_NAME=
KIT_SEARCH_REGION=
KIT_SEARCH_RETENTION=
KIT_SEARCH_MONTHLY_BUDGET_CENTS=0
KIT_SEARCH_CENTS_PER_1000_CHARS=0
# Exactly 32 random bytes encoded as 64 hex characters. Back up securely.
KIT_SEARCH_ENCRYPTION_KEY=
# Optional native process environment (not loaded by Vite from this file):
# KIT_TESSERACT_PATH=/absolute/trusted/path/to/tesseract
# Install English and Spanish traineddata separately. Never set a renderer path.
